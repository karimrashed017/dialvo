# Names only. Put real values in .env.local (gitignored) or the hosting
# provider's settings. The site runs without any of these.

# The live voice demo on the home page (Voice tab). Server only: never give
# either of these a NEXT_PUBLIC_ name.
# ElevenLabs API key. Without it the demo falls back to the sample panel.
ELEVENLABS_API_KEY=
# Optional. The id of the ElevenLabs agent to use (agent_...). Leave empty and
# the server finds or creates the agent named "Dialvo website demo" itself.
ELEVENLABS_AGENT_ID=

# Vercel Blob token for the private "dialvo-waitlist" store, where waitlist
# sign-ups are saved. Vercel sets it when the store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# The app (login, /app). From the Supabase project's settings, under API keys.
# Without the first two, /login and /app show "Dialvo's app is being set up"
# and the marketing site is unaffected. Next.js builds these two into the
# pages, so redeploy after changing them.
# The project's URL (https://<ref>.supabase.co). Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). Safe in the browser: it can only
# do what row-level security allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...). Server only: never give it a NEXT_PUBLIC_
# name. Optional for now: the public lead form uses it when it is set, and
# works without it. Later slices (agents, webhooks) will need it.
SUPABASE_SECRET_KEY=
