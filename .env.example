# Names only. Put real values in .env.local (gitignored) or the hosting
# provider's settings. The site runs without any of these.

# The live voice demo on the home page (Voice tab). Server only: never give
# either of these a NEXT_PUBLIC_ name.
# ElevenLabs API key. Without it the demo falls back to the sample panel.
ELEVENLABS_API_KEY=
# Optional. The id of the ElevenLabs agent to use (agent_...). Leave empty and
# the server finds or creates the agent named "Dialvo website demo" itself.
ELEVENLABS_AGENT_ID=

# Vercel Blob token for the private "dialvo-waitlist" store, where waitlist
# sign-ups are saved. Vercel sets it when the store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# The app (login, /app). From the Supabase project's settings, under API keys.
# Without the first two, /login and /app show "Dialvo's app is being set up"
# and the marketing site is unaffected. Next.js builds these two into the
# pages, so redeploy after changing them.
# The project's URL (https://<ref>.supabase.co). Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). Safe in the browser: it can only
# do what row-level security allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...). Server only: never give it a NEXT_PUBLIC_
# name. The inbound chat agent needs it to read a workspace's knowledge and
# store its replies. Without it the lead form and the chat widget still save
# everything to the Inbox, and no agent answers.
SUPABASE_SECRET_KEY=

# The inbound chat agent (src/lib/agents). Server only: never give it a
# NEXT_PUBLIC_ name. An Anthropic API key. Without it (or without
# SUPABASE_SECRET_KEY above) the agent stays off: the app says so, and
# visitors' chat messages are still saved to the Inbox for the team.
ANTHROPIC_API_KEY=
# "Find leads" (src/lib/prospects) needs the same two keys: this one for the
# model and its web search, SUPABASE_SECRET_KEY to run and count a search.
# Without either the section says it isn't switched on yet; saved searches
# and the never-contact list still work. No other variable is needed.
# Sending (src/lib/mail) needs no variable of its own. SUPABASE_SECRET_KEY
# sends and reads mail (it alone can read a mailbox's password out of Vault);
# this key writes follow-ups and reads replies; RESEND_API_KEY below sends
# the alert when a lead replies with interest. The scheduler's token is made
# in the database and kept in Supabase Vault, not here.
# and the never-contact list still work.

# Optional. Findymail API key, for "Find leads" (src/lib/prospects/findymail.ts).
# Server only: never give it a NEXT_PUBLIC_ name. With it, runs look up
# matching companies, a named decision-maker at each and their verified work
# email in Findymail's contact database (Intellimatch), within the daily
# credit cap in src/lib/prospects/config.ts. Without it, runs search the web
# as before.
FINDYMAIL_API_KEY=

# Email alerts to a workspace's own team (a chat was qualified, needs a
# person, or has a draft waiting). Server only: never give it a NEXT_PUBLIC_
# name. A Resend API key that may send from trydialvo.com. Alerts also need
# SUPABASE_SECRET_KEY above, to read who to email. Without either, nothing is
# sent and Settings says email alerts aren't switched on yet.
RESEND_API_KEY=

# The trial clock's one switch. Leave it unset until customers can pay.
# Only the exact value 1 turns enforcement on: a workspace whose free trial
# has ended, with no paid plan, then has its agent stop replying (chats wait
# for the team) and the app asks for a plan. With anything else, nothing is
# blocked when a trial ends.
BILLING_ENFORCED=

# Calls, phone numbers and texts (src/lib/phone), on Twilio. Server only:
# never give these a NEXT_PUBLIC_ name. One Twilio account holds every
# workspace's numbers. Without the first two (and SUPABASE_SECRET_KEY above)
# the Calls pages say exactly what is missing and nothing can be bought,
# dialled or texted. The phone agent also needs ANTHROPIC_API_KEY; without it
# calls go to the workspace's transfer number.
# The account id (AC...), from Twilio's console.
TWILIO_ACCOUNT_SID=
# The account's auth token. Also verifies every Twilio webhook's signature.
TWILIO_AUTH_TOKEN=
# Optional. Where Twilio calls the app back, when it isn't
# https://trydialvo.com (a preview deployment). No trailing slash. Twilio
# signs this exact address, so it must be the public one.
TWILIO_WEBHOOK_BASE_URL=
